@startuml order-sell-sequence-final
title
TradeSim — SELL shares
Execution target, not implemented by the current class-file skeleton
endtitle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
autonumber
actor User as U
participant "view: OrderView" as V #E6F3E8
participant "controller: SellOrderController" as C #E6F3E8
participant "input: SellOrderInputBoundary\n(runtime SellOrderInteractor)" as I #FBE6EC
participant "accounts: OrderAccountGateway\n(runtime OrderAccountAdapter)" as A #FFF0DB
participant "quotes: OrderQuoteGateway\n(runtime shared StockQuoteGateway)" as Q #EDF0F5
participant "output: SellOrderOutputBoundary\n(runtime SellOrderPresenter)" as P #E6F3E8
participant "viewModel: OrderViewModel" as VM #E6F3E8
note over V,VM
  These are runtime objects. Boundary labels are their declared types,
  not separate interface objects. Application wiring registers the View listener.
end note
U -> V : click SELL
V -> V : userID = currentUserId.get()\n(callback wired to session::getUserID)
V -> C : placeOrder(userID, symbol, quantity)
C -> C : create PlaceOrderInputData\n(no client-selected type)
C -> I : execute(input)
activate I
break Invalid ID/symbol or quantity <= 0
  I -> P : present(rejected(INVALID_REQUEST))
  P -> VM : update(status, message, null, "")
  VM ->> V : propertyChange(event)
end
I -> A : findAccount(userID, normalizedSymbol)
A --> I : Optional<OrderAccountSnapshot>
break Account missing
  I -> P : present(rejected(ACCOUNT_NOT_FOUND))
  P -> VM : update(status, message, null, "")
  VM ->> V : propertyChange(event)
end
I -> Q : findPrice(normalizedSymbol)
Q --> I : Optional<BigDecimal>
break Price absent or <= 0
  I -> P : present(rejected(QUOTE_UNAVAILABLE))
  P -> VM : update(status, message, null, "")
  VM ->> V : propertyChange(event)
end
I -> I : create candidate Order with fixed SELL\n(UUID, userID, symbol, quantity, price, clock.instant())
break held < quantity
  I -> P : present(rejected(INSUFFICIENT_SHARES))
  P -> VM : update(status, message, null, "")
  VM ->> V : propertyChange(event)
end
I -> I : updated = (cash + total, held - quantity)
I -> A : commitTrade(order, expected, updated)
activate A
group REQUIRED account-wide transaction / coordinated atomic commit
  A -> A : compare current cash + this holding with expected
  alt Account changed or disappeared
    A -> A : no writes
  else Expected state still current
    A -> A : commit cash + target holding + appended history together
    note right of A
      Preserve other holdings and prior history.
      Stage changes; do not partially mutate a live User.
      findById + save signatures alone do not ensure this.
    end note
  end
end
A --> I : true = committed; false = missing/changed with zero writes
deactivate A
alt true
  I -> P : present(filled(order))
else false
  I -> P : present(rejected(ACCOUNT_CHANGED))
end
deactivate I
P -> P : map status to sell-specific message\nformat money for display
P -> VM : update(status, message, orderID, totalText)
VM ->> V : propertyChange(event)
V -> VM : read status, message, orderID, totalText
VM --> V : display state
V -> U : display result
opt New FILLED orderID not refreshed before
  V -> V : refreshPortfolio.accept(currentUserId.get())\n(callback wired to PortfolioController.viewPortfolio)
  note right of V
    Refresh errors do not undo or reject a committed trade.
  end note
end
note over A,P
  Technical I/O failures need separate handling and rollback.
  They must not be reported as ACCOUNT_CHANGED or false success.
  This sequence is the intended implementation; current methods are TODO scaffolds.
end note
@enduml
